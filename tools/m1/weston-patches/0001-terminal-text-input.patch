+static void
+terminal_global_handler(struct display *display, uint32_t name,
+			const char *interface, uint32_t version, void *data)
+{
+	struct terminal *terminal = data;
+
+	if (strcmp(interface, "zwp_text_input_manager_v1") != 0)
+		return;
+
+	terminal->text_input_manager =
+		display_bind(display, name,
+			     &zwp_text_input_manager_v1_interface, 1);
+	terminal->text_input =
+		zwp_text_input_manager_v1_create_text_input(terminal->text_input_manager);
+	zwp_text_input_v1_add_listener(terminal->text_input,
+				       &text_input_listener, terminal);
+}
+
 static void
 keyboard_focus_handler(struct window *window,
 		       struct input *device, void *data)
 {
 	struct terminal *terminal = data;
 
+	if (terminal->text_input) {
+		if (device) {
+			terminal->text_input_seat = input_get_seat(device);
+			zwp_text_input_v1_activate(terminal->text_input,
+						   terminal->text_input_seat,
+						   window_get_wl_surface(terminal->window));
+			zwp_text_input_v1_show_input_panel(terminal->text_input);
+		} else if (terminal->text_input_seat) {
+			zwp_text_input_v1_deactivate(terminal->text_input,
+						     terminal->text_input_seat);
+		}
+	}
+
 	window_schedule_redraw(terminal->window);
 }
 
