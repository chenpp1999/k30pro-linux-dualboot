+		terminal->scrolling = 0;
+		widget_schedule_redraw(terminal->widget);
+	}
 	char buf[MAX_RESPONSE];
 	size_t len = 0;
 	xkb_mod_mask_t mods = 0;
@@ -2834,6 +2866,22 @@
 				   int32_t index, uint32_t length)
 {
 	struct terminal *terminal = data;
