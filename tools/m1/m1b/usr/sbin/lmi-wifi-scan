#!/bin/sh
# SPDX-License-Identifier: MIT
# lmi-wifi-scan - list visible WiFi networks (SSID / signal / security).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IF=${LMI_WIFI_IF:-wlan0}
[ -e "/sys/class/net/$IF" ] || { echo "wifi: $IF missing" >&2; exit 1; }
echo "scanning on $IF ..."
iw dev "$IF" scan 2>/dev/null | awk '
	/^BSS /            { ssid=""; sig=""; priva=""; }
	/^\tSSID: /        { ssid=substr($0, 8) }
	/^\tsignal: /      { sig=$2 }
	/^\tcapability: /  { if ($0 ~ /Privacy/) priva="WPA/WEP"; else priva="open" }
	/^\tDS Parameter/  { chan=$5 }
	ssid != "" && sig != "" {
		printf "%-32s %6s dBm  chan %-3s %s\n", ssid, sig, chan, priva;
		ssid="";
	}' | sort -u | head -40
