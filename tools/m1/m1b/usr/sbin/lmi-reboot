#!/bin/sh
# SPDX-License-Identifier: MIT
# lmi-reboot - leave Linux with a *clean* (warm) reboot.
#
# Why not the power button: holding it makes the PMIC do a hard reset and the
# next boot is a cold boot; the bootloader then re-initializes the broken
# AW8697 vibrator and spends ~273 s retrying i2c before the Redmi logo goes
# away.  An in-system reboot is a PS_HOLD warm reset (~3 s).  See
# docs/usage.md and the 2026-09-16 notes.
#
# usage:
#   lmi-reboot [--dry-run] [--no-sync]
#
# `reboot` (busybox) -> reboot(2) -> warm reset; never `-f`/sysrq, which can
# take a different (harder) path.
set -eu

DRY=0
SYNC=1
for a in "$@"; do
	case "$a" in
	--dry-run) DRY=1 ;;
	--no-sync) SYNC=0 ;;
	-h | --help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "usage: lmi-reboot [--dry-run] [--no-sync]" >&2; exit 1 ;;
	esac
done

if [ "$DRY" = 1 ]; then
	echo "DRY-RUN: would run: sync; reboot   (warm reset back to Android)"
	exit 0
fi

echo "lmi-reboot: clean reboot (any later boot returns to Android)"
[ "$SYNC" = 1 ] && sync
exec reboot
