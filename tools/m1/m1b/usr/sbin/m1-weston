#!/bin/sh
# m1-weston — Weston launcher for lmi (persistent rootfs, weston 14.x, pixman/DSI-1).
#
# Owns every child process: TERM/INT tears them down before exit, so an OpenRC
# stop/restart can never race a leftover compositor for the DRM seat (UX audit A4,
# 2026-09-14). Bounded waits everywhere; retries with a fallback config if weston
# refuses to come up (e.g. broken weston.ini).
set -u

CONF=/etc/xdg/weston/weston.ini
FALLBACK=/etc/xdg/weston/weston.ini.fallback
RUNDIR=/run/lmi-weston
SOCK=wayland-0
RETRIES=3
BACKOFF=3
SEAT_WAIT=15
# CRTC-off timeout for inactivity; lmi-keys turns the backlight off at the
# same time. This is passed on the command line because --idle-time
# overrides the [core] idle-time from weston.ini. 0 = never idle.
IDLE_TIME=300
# 1 = kiosk shell (one fullscreen client, no panel/launchers) for a
# single-purpose setup; 0 = desktop shell (default).
KIOSK=0
# cursor theme for the clients. The stock rootfs ships no cursor theme, so the
# clients log 'could not load cursor ...' (cosmetic: lmi is touch-only and the
# Adwaita theme is ~12 MB of symlink-heavy files - not worth shipping). Point
# these at a theme if one gets installed later.
XCURSOR_THEME=${XCURSOR_THEME:-}
XCURSOR_SIZE=${XCURSOR_SIZE:-24}
# shellcheck source=/dev/null
[ -r /etc/conf.d/m1-weston ] && . /etc/conf.d/m1-weston
export XCURSOR_THEME XCURSOR_SIZE

log() { printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$$" "$*"; }

WPID=''; C1=''; C2=''; MTEST=''; FEEDER=''; WORK=''
STOPPING=0
trap 'STOPPING=1' TERM INT HUP

kill_wait() { # $1=pid $2=timeout_s
  _p=$1; _t=${2:-5}; _i=0
  [ -n "$_p" ] || return 0
  kill -TERM "$_p" 2>/dev/null
  while [ "$_i" -lt "$_t" ] && kill -0 "$_p" 2>/dev/null; do sleep 1; _i=$((_i+1)); done
  kill -0 "$_p" 2>/dev/null && kill -KILL "$_p" 2>/dev/null
  return 0
}

cleanup() {
  kill_wait "$C1" 3; kill_wait "$C2" 3
  kill_wait "$MTEST" 3; kill_wait "$FEEDER" 3
  if [ -n "$WPID" ]; then kill_wait "$WPID" 8; wait "$WPID" 2>/dev/null; fi
  [ -n "$WORK" ] && rm -rf "$WORK"
  rm -f "$RUNDIR/$SOCK"
  log "cleanup done"
}
trap cleanup EXIT

mkdir -p "$RUNDIR"; chmod 700 "$RUNDIR"
export XDG_RUNTIME_DIR="$RUNDIR"

# Refresh the fontconfig cache before any client starts.  On a cold boot the
# clock is still the swclock timestamp (often in the past) while the fonts are
# newer, so fontconfig may be rebuilding its cache exactly when the first
# cairo client (terminal/keyboard) starts, which can leave it without CJK
# glyphs (tofu) until the next restart.  Cheap for 3 fonts.
if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f >/dev/null 2>&1 || log "WARN: fc-cache failed"
fi

wait_seat() {
  i=0
  while [ "$i" -lt "$SEAT_WAIT" ]; do
    [ -S /run/seatd.sock ] && [ -e /dev/dri/card0 ] && return 0
    i=$((i+1)); sleep 1
  done
  return 1
}

sweep_stale() { # only a leftover weston from a killed/daemonized run
  pgrep -x weston >/dev/null 2>&1 || return 0
  log "stale weston detected; terminating"
  kill_wait "$(pgrep -x weston)" 8
  pgrep -x weston >/dev/null 2>&1 && { log "WARN: stale weston survived"; return 1; }
  return 0
}

splash_release() { # D80-proven modetest sequence, bounded
  WORK=$(mktemp -d /tmp/m1-weston.XXXXXX) || { WORK=''; return 0; }
  mkfifo "$WORK/input" || { rm -rf "$WORK"; WORK=''; return 0; }
  tail -f /dev/null > "$WORK/input" & FEEDER=$!
  modetest -a -s '29@129:#0@XR24' -P '58@129:1080x2400@XR24' < "$WORK/input" & MTEST=$!
  sleep 3
  kill_wait "$FEEDER" 2; FEEDER=''
  kill_wait "$MTEST" 5; MTEST=''
  rm -rf "$WORK"; WORK=''
}

start_weston() { # $1=config file
  shell_args=""
  [ "${KIOSK:-0}" = 1 ] && shell_args="--shell=kiosk-shell.so"
  # shellcheck disable=SC2086
  weston --config="$1" --backend=drm-backend.so --drm-device=card0 \
    --renderer=pixman --socket="$SOCK" --idle-time="$IDLE_TIME" \
    $shell_args \
    --continue-without-input --debug --log=/var/log/weston.log &
  WPID=$!
  i=0
  while [ "$i" -lt 20 ]; do
    [ -S "$RUNDIR/$SOCK" ] && return 0
    if ! kill -0 "$WPID" 2>/dev/null; then WPID=''; return 1; fi
    i=$((i+1)); sleep 1
  done
  return 1
}

attempt=0
while :; do
  attempt=$((attempt+1))
  wait_seat || log "WARN: seatd/dri not ready after ${SEAT_WAIT}s"
  sweep_stale || log "WARN: DRM seat may still be busy"
  splash_release
  conf=$CONF
  if [ "${conf_override:-0}" = 1 ] || { [ "$attempt" -gt 3 ] && [ -f "$FALLBACK" ]; }; then
    conf=$FALLBACK; log "retry with fallback config: $FALLBACK"
  fi
  if start_weston "$conf"; then
    log "weston up (attempt $attempt)"
    WAYLAND_DISPLAY="$SOCK" weston-terminal --maximized --font-size=16 & C1=$!
    WAYLAND_DISPLAY="$SOCK" weston-editor & C2=$!
    wait "$WPID"; rc=$?; WPID=''
    [ "$STOPPING" = 1 ] && { log "stop requested"; exit 0; }
    log "weston exited rc=$rc (restarting)"
    # A compositor crash must never leave the device without a UI: keep
    # retrying forever with a growing (bounded) backoff instead of giving up.
    attempt=0
    sleep "$BACKOFF"
  else
    log "weston failed to start (attempt $attempt)"
    kill_wait "$WPID" 3; WPID=''
    [ "$STOPPING" = 1 ] && exit 0
    if [ "$attempt" -lt 20 ]; then
      sleep "$BACKOFF"
      continue
    fi
    log "WARN: weston failed $attempt times in a row; backing off ${LONG_BACKOFF}s"
    sleep "${LONG_BACKOFF:-30}"
    attempt=0
  fi
done
