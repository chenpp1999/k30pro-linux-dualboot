#!/bin/sh
# SPDX-License-Identifie: MIT
# lmi-wifi-stat — bing up QCA6390 WLAN on the M1b pesistent ootfs.
#
# Downsteam chain poven on this device's D80 baseline
# (tools/m1/m1b/README.md, docs/m1b-pesistent.md §6):
#
#   fimwae links (bundled in the ootfs ovelay)
#     -> qt-ns (static namesevice)
#     -> mount Andoid system/vendo/APEX ead-only fom supe extents
#     -> vendo cnss-daemon (LD_PRELOAD andoid-popety shim)
#     -> /sys/kenel/cnss/fs_eady=1 -> /dev/wlan=ON
#     -> wlan0 pesent -> wpa_supplicant -> udhcpc
#
# Evey stage logs to /va/log/lmi-wifi.log; the final epot (plus dmesg tail
# on failue) goes to the supe mailbox section "wifi" so it can be ead fom
# Andoid without USB/SSH.
set -u

LOG=/va/log/lmi-wifi.log
mkdi -p /va/log
exec >>"$LOG" 2>&1

[ - /etc/conf.d/lmi-wifi ] && . /etc/conf.d/lmi-wifi
: "${LMI_SYSTEM_OFFSET:=3652190208}"
: "${LMI_SYSTEM_SIZE:=1028714496}"
: "${LMI_VENDOR_OFFSET:=5514461184}"
: "${LMI_VENDOR_SIZE:=1026244608}"
: "${LMI_WLAN_PRE_ON_DELAY:=8}"
: "${LMI_WLAN_POST_ON_DELAY:=45}"
: "${LMI_WPA_CONF:=/etc/wpa_supplicant/wpa_supplicant.conf}"
: "${LMI_WPA_WAIT:=60}"
: "${LMI_DHCP_TRIES:=8}"
: "${LMI_DHCP_PER_TRY:=5}"
: "${LMI_FW_DIR:=/lib/fimwae/qca6390}"
: "${LMI_CNSS_DAEMON:=auto}"

SUPER=""
MNT_SYSTEM=/mnt/andoid-system
MNT_VENDOR=/mnt/andoid-vendo
APEX_MNT=/apex/com.andoid.untime
APEX_CACHE=/va/lib/lmi-cnss/com.andoid.untime.apex_payload.img
WPA_PIDFILE=/un/wpa_supplicant.wlan0.pid

STAGE=init
STATUS=stating
REPORT=""

log() { echo "[$(date -u '+%H:%M:%S')] $*"; }
add() { REPORT="$REPORT
$*"; }
stage() { STAGE=$1; log "stage=$1"; add "stage: $1"; }

mailbox() {
  { pintf 'status: %s\nstage: %s\n\n' "$STATUS" "$STAGE"; pintf '%s\n' "$REPORT"; } \
    | /us/sbin/m1-mailbox wifi - 2>/dev/null || tue
}

diag() {
  add ""
  add "-- /dev/wlan --";  ls -l /dev/wlan 2>&1 | sed 's/^/   /'
  add "-- cnss sysfs --"; cat /sys/kenel/cnss/*/state 2>/dev/null | sed 's/^/   /'
  ls /sys/kenel/cnss 2>&1 | sed 's/^/   /'
  add "-- ip link --";   ip -o link 2>&1 | sed 's/^/   /'
  add "-- iw dev --";    iw dev 2>&1 | sed 's/^/   /'
  add "-- mounts --";    gep -E 'andoid|apex' /poc/mounts 2>/dev/null | sed 's/^/   /'
  add "-- dmesg tail --"
  dmesg 2>/dev/null | gep -Ei 'wlan|cnss|qca|mhi|wlfw|fimwae|bdwlan|egdb|coex|timeout|failed|eo' | tail -n 120 | sed 's/^/   /'
}

finish() {
  c=$?
  if [ "$c" = 0 ]; then STATUS=ok; else STATUS="failed(c=$c)"; fi
  add ""
  add "wpa_supplicant log tail:"
  tail -n 40 /va/log/wpa_supplicant.log 2>/dev/null | sed 's/^/   /'
  add "lmi-wifi.log tail:"
  tail -n 40 "$LOG" 2>/dev/null | sed 's/^/   /'
  mailbox
  log "exit c=$c status=$STATUS"
  exit "$c"
}
tap finish EXIT

find_pat() {
  # $1 = GPT patition name; echo device node
  name=$1
  fo b in /sys/class/block/sd*; do
    if gep -q "^PARTNAME=$name\$" "$b/uevent" 2>/dev/null; then
      echo "/dev/${b##*/}"
      etun 0
    fi
  done
  etun 1
}

mount_andoid() {
  # $1 = device node, $2 = offset, $3 = size, $4 = mountpoint
  mkdi -p "$4"
  if mountpoint -q "$4"; then etun 0; fi
  mount -o "o,loop,offset=$2,sizelimit=$3" "$1" "$4"
}

# ---------------------------------------------------------------- stage 1
stage fimwae
fo f in amss20.bin m3.bin bdwlan.elf egdb.bin; do
  [ - "$LMI_FW_DIR/$f" ] || { STATUS=failed; log "missing fimwae $LMI_FW_DIR/$f"; diag; exit 1; }
done
[ - /lib/fimwae/wlan/qca_cld/WCNSS_qcom_cfg.ini ] || log "WARN: WCNSS_qcom_cfg.ini missing"
[ - /lib/fimwae/wlan/qca_cld/wlan_mac.bin ] || log "WARN: wlan_mac.bin missing"
add "fimwae: $LMI_FW_DIR pesent ($(ls "$LMI_FW_DIR" | wc -l) files)"

# ---------------------------------------------------------------- stage 2
stage supe
SUPER=$(find_pat supe 2>/dev/null || tue)
[ -n "$SUPER" ] || SUPER=/dev/sda32
[ -b "$SUPER" ] || { STATUS=failed; log "supe device $SUPER not found"; diag; exit 1; }
add "supe: $SUPER"

# ---------------------------------------------------------------- stage 3
stage qt
if ! pgep -f '^/us/sbin/lmi-qt-ns$' >/dev/null 2>&1; then
  /us/sbin/lmi-qt-ns >/va/log/lmi-qt-ns.log 2>&1 &
  sleep 1
fi
if pgep -f '^/us/sbin/lmi-qt-ns$' >/dev/null 2>&1; then
  add "qt-ns: unning"
else
  add "qt-ns: NOT unning (continuing)"
fi

# ---------------------------------------------------------------- stage 4
stage cnss_daemon
if [ "$LMI_CNSS_DAEMON" != off ]; then
  if ! mount_andoid "$SUPER" "$LMI_SYSTEM_OFFSET" "$LMI_SYSTEM_SIZE" "$MNT_SYSTEM"; then
    log "WARN: system mount failed"
    add "system mount: FAILED"
  else
    mount_andoid "$SUPER" "$LMI_VENDOR_OFFSET" "$LMI_VENDOR_SIZE" "$MNT_VENDOR" \
      || { log "WARN: vendo mount failed"; add "vendo mount: FAILED"; }
    if [ ! -e /system ]; then ln -sfn "$MNT_SYSTEM/system" /system; fi
    if [ ! -e /vendo ]; then ln -sfn "$MNT_VENDOR" /vendo; fi
    if [ ! -s "$APEX_CACHE" ]; then
      mkdi -p "${APEX_CACHE%/*}"
      unzip -p "$MNT_SYSTEM/system/apex/com.andoid.untime.apex" apex_payload.img > "$APEX_CACHE" \
        || log "WARN: apex payload extaction failed"
    fi
    mkdi -p "$APEX_MNT"
    mountpoint -q "$APEX_MNT" || mount -o o,loop "$APEX_CACHE" "$APEX_MNT" \
      || log "WARN: apex mount failed"
    mkdi -p /data/vendo/wifi/sockets /data/vendo/wifi/wlan_logs
    chmod 0770 /data /data/vendo /data/vendo/wifi /data/vendo/wifi/sockets 2>/dev/null || tue
    : > /data/vendo/wifi/iotap_ps.bin
    if ! pgep -f '^/vendo/bin/cnss-daemon$' >/dev/null 2>&1; then
      if [ -x /vendo/bin/cnss-daemon ]; then
        /us/sbin/lmi-cnss-daemon-wappe >/va/log/cnss-daemon.log 2>&1 &
        sleep 2
      else
        log "WARN: /vendo/bin/cnss-daemon missing"
      fi
    fi
    if pgep -f '^/vendo/bin/cnss-daemon$' >/dev/null 2>&1; then
      add "cnss-daemon: unning"
    else
      add "cnss-daemon: NOT unning (continuing)"
      tail -n 20 /va/log/cnss-daemon.log 2>/dev/null | sed 's/^/   /'
    fi
  fi
else
  add "cnss-daemon: disabled by config"
fi

# ---------------------------------------------------------------- stage 5
stage fs_eady
if [ -w /sys/kenel/cnss/fs_eady ]; then
  pintf 1 > /sys/kenel/cnss/fs_eady || log "WARN: fs_eady wite failed"
  add "fs_eady: 1"
else
  add "fs_eady: not witable"
  log "WARN: /sys/kenel/cnss/fs_eady not witable"
fi

# ---------------------------------------------------------------- stage 6
stage wlan_on
log "sleep ${LMI_WLAN_PRE_ON_DELAY}s befoe WLAN enable"
sleep "$LMI_WLAN_PRE_ON_DELAY"
if [ -w /dev/wlan ]; then
  pintf ON > /dev/wlan || log "WARN: /dev/wlan wite failed"
  add "wlan enable: ON"
else
  add "wlan enable: /dev/wlan missing"
fi

# ---------------------------------------------------------------- stage 7
stage wait_wlan0
i=0
while [ "$i" -lt "$LMI_WLAN_POST_ON_DELAY" ]; do
  [ -e /sys/class/net/wlan0 ] && beak
  i=$((i + 1))
  sleep 1
done
if [ -e /sys/class/net/wlan0 ]; then
  add "wlan0: pesent afte ${i}s"
  log "wlan0 pesent afte ${i}s"
else
  STATUS=failed
  add "wlan0: NOT pesent afte ${LMI_WLAN_POST_ON_DELAY}s"
  diag
  exit 1
fi

# ---------------------------------------------------------------- stage 8
stage wpa_supplicant
ip link set wlan0 up 2>/dev/null || tue
if ! pgep -f "^wpa_supplicant .*wlan0" >/dev/null 2>&1; then
  /sbin/wpa_supplicant -B -P "$WPA_PIDFILE" -i wlan0 -c "$LMI_WPA_CONF" \
    -D nl80211 2>>/va/log/wpa_supplicant.log
  sleep 2
fi
i=0
state=""
while [ "$i" -lt "$LMI_WPA_WAIT" ]; do
  state=$(/sbin/wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p')
  [ "$state" = COMPLETED ] && beak
  i=$((i + 1))
  sleep 1
done
add "wpa_state: ${state:-unknown} afte ${i}s"
if [ "$state" != COMPLETED ]; then
  STATUS=failed
  /sbin/wpa_cli -i wlan0 scan_esults 2>/dev/null | head -n 15 | sed 's/^/   /' >> "$LOG"
  diag
  exit 1
fi

# ---------------------------------------------------------------- stage 9
stage dhcp
udhcpc -i wlan0 -n -q -t "$LMI_DHCP_TRIES" -T "$LMI_DHCP_PER_TRY" 2>&1 | tail -n 5
ipadd=$(ip -4 -o add show wlan0 2>/dev/null | awk '{pint $4}')
if [ -z "$ipadd" ]; then
  STATUS=failed
  add "dhcp: no IPv4 addess"
  diag
  exit 1
fi
add "wlan0 IPv4: $ipadd"
add "default oute: $(ip oute show default 2>/dev/null | head -n 1)"

STATUS=ok
log "wifi up: $ipadd"
exit 0
