#!/usr/bin/env sh
# busybox ntpd -S callback (step / stratum change / every ~11 min).
#
# The PMIC RTC on lmi is read-only from the AP (`hwclock -w` fails with
# ioctl EPERM), so we fall back to OpenRC swclock's timestamp file: its mtime is
# restored as the boot time, and NTP steps the clock once the network is up.
case "$1" in
	step|stratum|periodic)
		/sbin/hwclock -w -u 2>/dev/null && exit 0
		touch /var/lib/misc/openrc-shutdowntime 2>/dev/null
		;;
esac
exit 0
