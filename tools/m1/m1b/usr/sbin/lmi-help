#!/bin/sh
# SPDX-License-Identifier: MIT
# lmi-help - cheat sheet for the lmi Linux side: big title + the commands that
# matter day to day.  Used three ways:
#
#   lmi-help                 print the sheet (and drop into a shell if on a tty)
#   lmi-help --no-shell      print only (SSH login banner)
#   weston-terminal --shell=/usr/sbin/lmi-help
#                            the on-screen "welcome" window on the desktop
#
# Everything below has to stay readable on a 540-logical-pixel-wide panel and
# in an 80-column SSH session, so keep the box at <= 62 characters.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

NO_SHELL=0
for a in "$@"; do
	case "$a" in
	--no-shell|-n) NO_SHELL=1 ;;
	-i|*) : ;;   # weston-terminal passes -i when this runs as the shell
	esac
done

# LMI_NO_MOTD=1 gives a plain terminal (no banner) - handy when you just want a
# shell, and it keeps scripts/sourced shells quiet.
if [ -n "${LMI_NO_MOTD:-}" ]; then
	[ -t 0 ] && [ -t 1 ] && exec /bin/sh -i
	exit 0
fi

# one line per invocation: makes it obvious whether a given window got the sheet
printf '%s lmi-help pid=%s tty=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$$" \
	"$(tty 2>/dev/null)" >> /var/log/lmi-help.log 2>/dev/null || true

# hostname / addresses for the header
host=$(hostname 2>/dev/null || echo lmi)
usb=172.16.42.1
wifi=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
[ -n "$wifi" ] || wifi="(未连接)"
soc=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo '?')
temp=$(cat /sys/class/power_supply/battery/temp 2>/dev/null || echo '?')
gw=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo '?')

line() { printf '%s\n' "$1"; }
box() { # $1 = title
	printf '\033[1;36m'
	line '+------------------------------------------------------------+'
	printf '| %-58s |\n' "$1"
	line '+------------------------------------------------------------+'
	printf '\033[0m'
}
item() { printf '\033[1;33m  %-22s\033[0m %s\n' "$1" "$2"; }

clear 2>/dev/null || true
printf '\033[1;32m'
cat <<'BANNER'
   _     __  __ ___    _   _      _ _
  | |   |  \/  |_ _|  | | | | ___| | | __ _
  | |   | |\/| || |   | |_| |/ _ \ | |/ _` |
  | |___| |  | || |   |  _  |  __/ | | (_| |
  |_____|_|  |_|___|  |_| |_|\___|_|_|\__,_|
BANNER
printf '\033[0m'
printf '  %s · Android/Linux 双系统 · Linux 侧常用指令\n' "$host"
printf '  USB %s   WiFi %s   电量 %s%%  电池 %s.%s°C  governor %s\n' \
	"$usb" "$wifi" "$soc" "$(printf '%s' "$temp" | cut -c1-2)" "$(printf '%s' "$temp" | cut -c3)" "$gw"

box "1. 系统切换 / 电源"
item "回 Android" "lmi-reboot（或 reboot）；别长按电源键硬复位"
item "Android→Linux" "Magisk 模块 lmi-dualboot-switch → 操作"
item "息屏 / 唤醒" "电源键短按；音量键调背光；空闲 300s 灭背光"
item "长按电源键 3s" "干净重启回 Android（比电源键硬复位快约 4 分钟）"

box "2. WiFi"
item "lmi-wifi-status" "一行状态（接口/SSID/IP）"
item "lmi-wifi-scan" "扫描可见网络"
item "lmi-wifi-join <SSID> <密钥>" "连接（开放网络用 -）"
item "rc-service lmi-wifi restart" "重来一遍 bring-up（掉线自救）"

box "3. 监测台（本机健康）"
item "lmi-status" "一屏摘要（-j 原始 / -w 单行）"
item "网页面板" "浏览器开 http://172.16.42.1:8080/"
item "CSV 历史" "/var/log/lmi-monitor/YYYY-MM-DD.csv"

box "4. 充电 / 温控 / 降温"
item "状态" "cat /run/lmi-chargectl.state"
item "调阈值" "/etc/conf.d/lmi-power 然后 restart lmi-chargectl"
item "降热/满频" "lmi-power -s（省电） / lmi-power -p（满频）"
item "说明" "默认停充 80% / 恢复 70%、42/38°C"

box "5. 输入 / 桌面"
item "手电筒" "面板手电图标（或终端 lmi-torch toggle）"
item "中文输入" "点输入框 → 拼音 → 点候选字；←/→ 翻页"
item "快捷键栏" "Ctrl/Alt 单击=锁一次，双击=常锁"
item "单应用全屏" "/etc/conf.d/m1-weston KIOSK=1 后重启 m1-weston"

box "6. 服务与日志"
item "rc-status" "所有服务状态"
item "rc-service <名> restart" "重启某项服务"
item "日志" "/var/log/{weston,lmi-wifi,lmi-chargectl,lmi-monitor.out}.log"
item "完整说明书" "/usr/share/lmi/usage.md（仓库 docs/usage.md）"

printf '\n  提示：本页可随时用 \033[1;33mlmi-help\033[0m 再看一遍。\n\n'

if [ "$NO_SHELL" = 0 ] && [ -t 0 ] && [ -t 1 ]; then
	printf '  进入 shell（exit 退出）…\n\n'
	exec /bin/sh -i
fi
