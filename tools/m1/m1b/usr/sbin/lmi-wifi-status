#!/bin/sh
# SPDX-License-Identifier: MIT
# lmi-wifi-status - show the current WiFi state in one line (phone friendly).
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IF=${LMI_WIFI_IF:-wlan0}
if [ ! -e "/sys/class/net/$IF" ]; then
	echo "wifi: interface $IF missing (run: rc-service lmi-wifi start)"
	exit 1
fi
ip4=$(ip -4 addr show "$IF" 2>/dev/null | awk '/inet /{print $2}')
ssid=$(iwinfo "$IF" info 2>/dev/null | awk -F: '/ESSID/{gsub(/^ +/,"",$2); print $2}' )
[ -n "$ssid" ] || ssid=$(wpa_cli -i "$IF" status 2>/dev/null | awk -F= '/^ssid=/{print $2}')
state=$(cat "/sys/class/net/$IF/operstate" 2>/dev/null)
printf 'wifi: if=%s state=%s ssid=%s ip=%s\n' "$IF" "${state:-?}" "${ssid:-?}" "${ip4:-none}"
