#!/bin/sh
# SPDX-License-Identifier: MIT
# /etc/conf.d/m1-weston - tunables for the weston launcher.
# Sourced by /usr/sbin/m1-weston (see its header for details).

# Weston start attempts, backoff seconds, seat wait.
RETRIES=3
BACKOFF=3
SEAT_WAIT=15

# CRTC-off timeout (seconds) when idle; lmi-keys turns the backlight off at the
# same time. 0 = never idle. Passed on the command line because --idle-time
# overrides the [core] idle-time from weston.ini.
IDLE_TIME=300

# 1 = kiosk shell (single fullscreen client, no panel/launchers)
# 0 = desktop shell with the panel and launchers (default)
KIOSK=0

# Client cursor theme/size. No cursor theme is shipped (touch-only device; the
# stock cursor theme is ~12 MB of symlink-heavy files) - leave empty unless a
# theme is installed into /usr/share/icons.
XCURSOR_THEME=
XCURSOR_SIZE=24

# Session windows.  HINT=1 opens the lmi-help cheat sheet maximized (big title +
# command table, then a shell) - it is the default and the only window unless
# the two below are enabled.  A finger drag scrolls the terminal (patch 0012).
HINT=1
TERMINAL=0
EDITOR=0

# Logical pixels reserved at the bottom of the terminal while the on-screen
# keyboard is up, so the last line (the shell prompt) is never hidden behind it.
# The K30 Pro panel is 540x1200 logical and the keyboard+shortcut bar take the
# bottom 480 px (measured 2026-09-15); raise this
# if the prompt still sits under the keyboard, 0 restores the stock behaviour.
KEYBOARD_INSET=480
