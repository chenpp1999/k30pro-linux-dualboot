#!/bin/busybox sh
# M0 ramboot init — k30pro-linux-dualboot
# Runs entirely in RAM. The only partition write is clearing the one-shot
# BCB flag on misc (architecture ADR-0001), so later reboots return to Android.

BB=/bin/busybox

$BB mount -t proc none /proc
$BB mount -t sysfs none /sys
$BB mount -t devtmpfs none /dev 2>/dev/null
$BB mkdir -p /dev/pts
$BB mount -t devpts none /dev/pts 2>/dev/null
$BB mkdir -p /run /root /etc/dropbear /sys/kernel/config
$BB mount -t configfs none /sys/kernel/config 2>/dev/null

# --- One-shot boot flag (BCB) cleanup: do this as early as possible ---
MISC=""
for b in /sys/class/block/sda*; do
  if $BB grep -q "^PARTNAME=misc$" "$b/uevent" 2>/dev/null; then
    MISC="/dev/$($BB basename "$b")"
    break
  fi
done
[ -n "$MISC" ] || MISC=/dev/sda11
if [ -b "$MISC" ]; then
  $BB dd if=/dev/zero of="$MISC" bs=32 count=1 conv=notrunc 2>/dev/null
  echo "BCB cleared on $MISC"
else
  echo "WARNING: misc partition not found; BCB not cleared"
fi

# convenience: applet symlinks for the interactive shell
$BB --install -s /bin 2>/dev/null

# --- USB network gadget: NCM preferred (Windows 11 24H2+ removed RNDIS),
#     fall back to RNDIS when NCM is unavailable in the kernel ---
G=/sys/kernel/config/usb_gadget/g1
NETFUNC=""
if [ -d /sys/kernel/config/usb_gadget ] && [ ! -d "$G" ]; then
  $BB mkdir -p "$G"
  echo 0x0525 > "$G/idVendor"
  echo 0xa4a2 > "$G/idProduct"
  $BB mkdir -p "$G/strings/0x409"
  echo "lmi-dualboot-0001" > "$G/strings/0x409/serialnumber"
  echo "k30pro-linux-dualboot" > "$G/strings/0x409/manufacturer"
  echo "M0 ramboot" > "$G/strings/0x409/product"
  $BB mkdir -p "$G/configs/c.1/strings/0x409"
  if $BB mkdir -p "$G/functions/ncm.usb0" 2>/dev/null; then
    NETFUNC=ncm.usb0
  else
    $BB mkdir -p "$G/functions/rndis.usb0"
    NETFUNC=rndis.usb0
  fi
  echo "$NETFUNC" > "$G/configs/c.1/strings/0x409/configuration"
  $BB ln -s "$G/functions/$NETFUNC" "$G/configs/c.1/" 2>/dev/null
  UDC=$($BB ls /sys/class/udc 2>/dev/null | $BB head -n1)
  if [ -n "$UDC" ]; then echo "$UDC" > "$G/UDC"; fi
fi

i=0
while [ $i -lt 15 ]; do
  [ -e /sys/class/net/usb0 ] && break
  i=$((i + 1))
  $BB sleep 1
done
$BB ip link set usb0 up 2>/dev/null
$BB ip addr add 172.16.42.1/24 dev usb0 2>/dev/null

# --- SSH (dropbear, host key generated at runtime into RAM) ---
/usr/sbin/dropbear -R -p 22 2>/dev/null

# --- telnet fallback ---
$BB telnetd -l /bin/sh -p 23 2>/dev/null

echo ""
echo "==================================================="
echo " lmi M0 ramboot (k30pro-linux-dualboot)"
echo " USB net : ${NETFUNC:-none} 172.16.42.1/24   (host: 172.16.42.2/24)"
echo " ssh     : root@172.16.42.1  (password in runbook)"
echo " telnet  : 172.16.42.1"
echo " touch   : run /bin/eventdump /dev/input/event*"
echo " NOTE    : nothing has been written to any partition"
echo "==================================================="

echo ""
echo "--- M0 self-report ---"
echo "[input devices]"
$BB grep -E '^N:|^H:' /proc/bus/input/devices 2>/dev/null || $BB ls /dev/input/ 2>/dev/null
echo "[network interfaces]"
$BB cat /proc/net/dev
echo "[usb gadget state]"
$BB cat /sys/class/udc/*/state 2>/dev/null
echo "[dmesg tail]"
$BB dmesg | $BB tail -n 25

while true; do $BB sleep 3600; done
