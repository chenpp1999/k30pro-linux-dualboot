#!/bin/sh
# SPDX-License-Identifier: MIT
# lmi-firstboot - one-time credential/identity setup for a *generic* M5 image.
#
# The generic image (docs/installer-design.md) must not ship any secret: not a
# root password, not an SSH host key, not a machine-id and not a WiFi network.
# Everything that has to be unique per device is created here, on the very
# first boot, and the root password is shown on screen so the user can capture
# it before the display is usable.
#
# Actions (idempotent; guarded by /etc/lmi-firstboot-done):
#   1. random root password -> /etc/shadow, shown on the console and saved to
#      /root/lmi-root-password.txt (0600);
#   2. dropbear host keys regenerated (never trust keys from an image);
#   3. /etc/machine-id regenerated;
#   4. SSH made public-key only (append "-s" to DROPBEAR_OPTS);
#   5. /root/.ssh (0700) prepared with an empty authorized_keys (0600);
#   6. /etc/lmi-firstboot-done + /var/log/lmi-firstboot.log written.
#
# usage:
#   lmi-firstboot [--dry-run] [--force] [--root <dir>]
#
#   --root <dir>  operate on a sandbox tree instead of / (used by
#                 tools/tests/m5-firstboot-test.sh; no chroot needed)
#   --dry-run     print what would happen, change nothing
#   --force       re-run even if the done marker exists
set -eu

ROOT=
DRY=0
FORCE=0
while [ $# -gt 0 ]; do
	case "$1" in
	--root) ROOT=$2; shift 2 ;;
	--dry-run) DRY=1; shift ;;
	--force) FORCE=1; shift ;;
	-h | --help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "FATAL: unknown option: $1" >&2; exit 1 ;;
	esac
done
ROOT=${ROOT%/}

P() { printf '%s%s\n' "$ROOT" "$1"; }
DONE=$(P /etc/lmi-firstboot-done)
LOG=$(P /var/log/lmi-firstboot.log)
SHADOW=$(P /etc/shadow)
PW_FILE=$(P /root/lmi-root-password.txt)

say() { printf 'lmi-firstboot: %s\n' "$*"; }
note() { printf 'lmi-firstboot: %s\n' "$*" >>"$LOG" 2>/dev/null || true; }

if [ -e "$DONE" ] && [ "$FORCE" != 1 ]; then
	say "already initialized ($DONE); nothing to do"
	exit 0
fi

run() {
	if [ "$DRY" = 1 ]; then
		say "DRY  : $*"
		return 0
	fi
	"$@"
}

random_hw() { # $1 = number of hex characters
	# busybox/coreutils both have od; avoid a base64 dependency.
	head -c 32 /dev/urandom | od -An -v -tx1 | tr -d ' \n' | cut -c1-"$1"
}

hash_password() { # prints a SHA-512 crypt hash
	if command -v openssl >/dev/null 2>&1; then
		openssl passwd -6 "$1" && return 0
	fi
	if python3 -c 'import crypt' >/dev/null 2>&1; then
		python3 -c 'import crypt,sys; print(crypt.crypt(sys.argv[1], crypt.mksalt(crypt.METHOD_SHA512)))' "$1" && return 0
	fi
	if command -v mkpasswd >/dev/null 2>&1; then
		mkpasswd -m sha-512 "$1" && return 0
	fi
	return 1
}

say "starting (root='${ROOT:-/}')"
[ "$DRY" = 1 ] || mkdir -p "$(dirname "$LOG")" "$(dirname "$PW_FILE")" "$(dirname "$DONE")"

# --- 1. random root password -------------------------------------------------
if [ ! -f "$SHADOW" ]; then
	say "WARN: no $SHADOW; skipping the root password step"
	note "WARN: $SHADOW missing"
else
	PW=$(random_hw 20)
	if [ "$DRY" = 1 ]; then
		say "DRY  : would set a random root password and store it in $PW_FILE (0600)"
	else
		HASH=$(hash_password "$PW") || { say "FATAL: no SHA-512 crypt tool (openssl/python3/mkpasswd)"; exit 1; }
		[ -n "$HASH" ] || { say "FATAL: empty password hash"; exit 1; }
		# Rewrite the root line in place (POSIX awk; no GNU sed -i).
		awk -v h="$HASH" 'BEGIN{FS=OFS=":"} $1=="root"{$2=h} {print}' "$SHADOW" >"$SHADOW.lmi" &&
			mv "$SHADOW.lmi" "$SHADOW"
		chmod 600 "$SHADOW"
		printf '%s\n' "$PW" >"$PW_FILE"
		chmod 600 "$PW_FILE"
		[ -w /dev/console ] &&
			printf 'lmi-firstboot: random root password for this device: %s\n' "$PW" >/dev/console 2>/dev/null || true
		say "root password set (shown on the console, saved in $PW_FILE)"
		note "root password rotated"
	fi
fi

# --- 2. dropbear host keys ---------------------------------------------------
DBDIR=$(P /etc/dropbear)
if command -v dropbearkey >/dev/null 2>&1; then
	for t in rsa ecdsa ed25519; do
		key="$DBDIR/dropbear_${t}_host_key"
		run dropbearkey -t "$t" -f "$key" >/dev/null
	done
	say "dropbear host keys regenerated"
	note "dropbear host keys regenerated"
else
	say "WARN: dropbearkey not found; host keys will be generated by dropbear on first start"
	note "WARN: dropbearkey not found"
fi

# --- 3. machine-id -----------------------------------------------------------
MID=$(P /etc/machine-id)
if [ "$DRY" = 1 ]; then
	say "DRY  : would regenerate $MID"
else
	mkdir -p "$(dirname "$MID")"
	rm -f "$MID" # an existing 0444 machine-id would reject truncation
	random_hw 32 >"$MID"
	say "machine-id regenerated"
	note "machine-id regenerated"
fi

# --- 4. SSH: public key only -------------------------------------------------
DCONF=$(P /etc/conf.d/dropbear)
if [ -f "$DCONF" ] && ! grep -q -- '-s' "$DCONF"; then
	if [ "$DRY" = 1 ]; then
		say "DRY  : would disable SSH password logins (-s) in $DCONF"
	else
		{
			echo ''
			echo '# lmi-firstboot: SSH is public-key only (no password logins)'
			echo 'DROPBEAR_OPTS="${DROPBEAR_OPTS} -s"'
		} >>"$DCONF"
		say "SSH password logins disabled ($DCONF)"
		note "DROPBEAR_OPTS + -s"
	fi
fi
SSHDIR=$(P /root/.ssh)
if [ "$DRY" = 1 ]; then
	say "DRY  : would prepare $SSHDIR (0700) with an empty authorized_keys (0600)"
else
	mkdir -p "$SSHDIR"
	chmod 700 "$SSHDIR"
	[ -e "$SSHDIR/authorized_keys" ] || : >"$SSHDIR/authorized_keys"
	chmod 600 "$SSHDIR/authorized_keys"
fi

# --- 6. done marker ----------------------------------------------------------
if [ "$DRY" = 1 ]; then
	say "DRY  : would write $DONE"
	say "dry-run complete; nothing was changed"
	exit 0
fi
printf 'first boot completed %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$DONE"
sync 2>/dev/null || true
say "done"
