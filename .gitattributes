# Keep build inputs and shell scripts LF even on Windows checkouts.
# tools/m0/init and tools/m0/kernel-cmdline.txt are consumed directly by the
# Debian build via adb push; CRLF breaks the busybox shebang (see issue #3).
* text=auto
*.sh text eol=lf
tools/m0/* text eol=lf
# M1b overlay payload is copied into the rootfs byte-for-byte (CRLF would break
# OpenRC init scripts / conf.d on the device).
tools/m1/m1b/** text eol=lf
# M5 generic-image firstboot payload is also copied into the rootfs and run.
tools/install/firstboot/** text eol=lf
# Binary payloads inside the overlay must never be normalized.
*.png binary
*.ttc binary
tools/m1/m1b/etc/localtime binary
tools/m1/m1b/usr/bin/* binary
tools/m1/m1b/usr/libexec/* binary
# lmi-keys is the only ELF in usr/sbin (cross-built static aarch64); keep git
# from trying to normalise it as text.
tools/m1/m1b/usr/sbin/lmi-keys binary
*.patch text eol=lf
*.dict binary
VERSION text eol=lf
