# Keep build inputs and shell scripts LF even on Windows checkouts.
# tools/m0/init and tools/m0/kernel-cmdline.txt are consumed directly by the
# Debian build via adb push; CRLF breaks the busybox shebang (see issue #3).
* text=auto
*.sh text eol=lf
tools/m0/* text eol=lf
# M1b overlay payload is copied into the rootfs byte-for-byte (CRLF would break
# OpenRC init scripts / conf.d on the device).
tools/m1/m1b/** text eol=lf
